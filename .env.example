# Giá trị mẫu cho Docker Compose; Spring Boot local nhận biến từ shell hoặc cấu hình IDE.
# Demo tự nạp catalog/tồn ban đầu 20–50; false để tự nhập sản phẩm/tồn.
DEMO_SEED_CATALOG=false
DB_HOST=localhost
DB_PORT=5433
DB_NAME=stockflow
DB_USERNAME=stockflow
DB_PASSWORD=stockflow_local_password
APP_PORT=8080
JWT_SECRET=stockflow-demo-secret-for-local-use-only-2026

# Local Gmail SMTP. Render Free: use MAIL_PROVIDER=brevo and configure the API key/sender below.
MAIL_PROVIDER=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
APP_MAIL_FROM=
MAIL_SENDER_NAME=StockFlow
# API key (not an SMTP key). APP_MAIL_FROM must match a verified sender in Brevo.
BREVO_API_KEY=

# Replace placeholders with the TMN/secret issued together by VNPay.
# Placeholders do not provide a working payment gateway.
VNPAY_TMN_CODE=DEMOVNPAY
VNPAY_HASH_SECRET=DEMOHASHSECRETKEY2026
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_STOREFRONT_URL=http://localhost:8080/

GHN_TOKEN=MOCK_TOKEN
# Public shop contact link, e.g. https://zalo.me/<shop-phone-or-OA-id>
ZALO_CONTACT_URL=https://zalo.me/0968935896
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/
GHN_PRODUCTION=false
GHN_SHOP_ID=123456
GHN_FROM_DISTRICT_ID=1450
GHN_SENDER_PHONE=

# Google Identity Services: Web application OAuth Client ID (không cần Client Secret).
GOOGLE_CLIENT_ID=1047952604572-ohm0aaqei4kbcae8t7d9gjgtdhg7he43.apps.googleusercontent.com
